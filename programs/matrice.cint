// Prodotto di matrici.
// Mostra gli array multidimensionali, che in CINT non sono un caso speciale: 'int[][]' e'
// semplicemente un array i cui elementi sono array di int.

int[][] prodotto(int[][] a, int[][] b) {
    int righe = len(a);
    int interne = len(b);
    int colonne = len(b[0]);

    int[][] c = new int[righe][colonne];

    int i = 0;
    while (i < righe) {
        int j = 0;
        while (j < colonne) {
            int somma = 0;
            int k = 0;
            while (k < interne) {
                somma += a[i][k] * b[k][j];
                k++
            }
            c[i][j] = somma;
            j++
        }
        i++
    }

    return c
}

void stampa(string nome, int[][] m) {
    print "${nome} =";
    int i = 0;
    while (i < len(m)) {
        print "  ${m[i]}";
        i++
    }
}

int[][] a = [[1, 2, 3], [4, 5, 6]];
int[][] b = [[7, 8], [9, 10], [11, 12]];

stampa("A", a);
stampa("B", b);
stampa("A x B", prodotto(a, b))
